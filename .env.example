# Backend environment variables — EXAMPLE FILE
# Copy to .env and fill in real values. NEVER commit .env with real secrets.

# Backend API base URL (used by frontend in Phase 3+)
VITE_API_URL=http://localhost:3001

# MongoDB connection string (backend only)
# MONGODB_URI=mongodb://localhost:27017/netlab

# JWT secret (backend only — use a long random string)
# JWT_SECRET=replace-with-a-long-random-secret

# Session expiry in seconds
# SESSION_EXPIRY=14400
